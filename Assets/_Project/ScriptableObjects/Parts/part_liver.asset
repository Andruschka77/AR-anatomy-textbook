  partId: part_liver
  titleRu: "\u041F\u0435\u0447\u0435\u043D\u044C"
  titleLatin: Hepar
  systemType: 5
  description: "\u041A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430 (1.5-1.8 \u043A\u0433).
    \u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0441\u0432\u044B\u0448\u0435
    500 \u0444\u0443\u043D\u043A\u0446\u0438\u0439: \u0434\u0435\u0442\u043E\u043A\u0441\u0438\u043A\u0430\u0446\u0438\u044F,
    \u0441\u0438\u043D\u0442\u0435\u0437 \u0431\u0435\u043B\u043A\u043E\u0432 \u043F\u043B\u0430\u0437\u043C\u044B,
    \u0434\u0435\u043F\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0433\u043B\u0438\u043A\u043E\u0433\u0435\u043D\u0430, \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u044F
    \u0436\u0435\u043B\u0447\u0438."
  clinicalFact: "\u041F\u0435\u0447\u0435\u043D\u044C \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E
    \u043A \u043F\u043E\u043B\u043D\u043E\u0439 \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u0438:
    \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0438
    \u0434\u043E 70% \u043E\u0431\u044A\u0435\u043C\u0430 \u043E\u043D\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0437\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0435\u043B\u044C."
  voiceoverClip: {fileID: 0}
