  titleRu: "\u0428\u0435\u0439\u043A\u0430 \u0438 \u043F\u0443\u0437\u044B\u0440\u043D\u044B\u0439
    \u043F\u0440\u043E\u0442\u043E\u043A"
  titleLatin: Collum et ductus cysticus
  systemType: 5
  description: "\u0421\u0443\u0436\u0435\u043D\u043D\u044B\u0439 \u0437\u0430\u0434\u043D\u0438\u0439
    \u043E\u0442\u0434\u0435\u043B, \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0449\u0438\u0439
    \u0432 \u043F\u0443\u0437\u044B\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u043E\u043A
    \u0441\u043E \u0441\u043F\u0438\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043B\u0430\u0434\u043A\u043E\u0439
    \u0413\u0435\u0439\u0441\u0442\u0435\u0440\u0430."
  clinicalFact: "\u0421\u043F\u0438\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043B\u0430\u0434\u043A\u0430
    \u0413\u0435\u0439\u0441\u0442\u0435\u0440\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u043A\u0430\u043A \u0437\u0430\u0441\u043B\u043E\u043D\u043A\u0430, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
    \u0442\u043E\u043D\u0443\u0441 \u0438 \u0442\u043E\u043A \u0436\u0435\u043B\u0447\u0438
    \u043F\u0440\u0438 \u0441\u043A\u0430\u0447\u043A\u0430\u0445 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F."
