  partId: bladder_fundus
  titleRu: "\u0414\u043D\u043E \u0438 \u0448\u0435\u0439\u043A\u0430 \u043C\u043E\u0447\u0435\u0432\u043E\u0433\u043E
    \u043F\u0443\u0437\u044B\u0440\u044F"
  titleLatin: Fundus et cervix vesicae
  systemType: 5
  description: "\u041D\u0438\u0436\u043D\u0438\u0439 \u043E\u0442\u0434\u0435\u043B
    \u0441 \u043C\u043E\u0447\u0435\u043F\u0443\u0437\u044B\u0440\u043D\u044B\u043C
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u043C
    \u041B\u044C\u0435\u0442\u043E, \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0449\u0438\u0439
    \u0432 \u0448\u0435\u0439\u043A\u0443 \u0441 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C
    \u0441\u0444\u0438\u043D\u043A\u0442\u0435\u0440\u043E\u043C \u0443\u0440\u0435\u0442\u0440\u044B."
  clinicalFact: "\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430 \u041B\u044C\u0435\u0442\u043E
    \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u043F\u043E\u0434\u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0433\u043E
    \u0441\u043B\u043E\u044F \u0438 \u0441\u043A\u043B\u0430\u0434\u043E\u043A, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F
    \u0431\u0435\u0441\u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043E\u0442\u0442\u043E\u043A \u043C\u043E\u0447\u0438."
