  titleRu: "\u041F\u043E\u0447\u0435\u0447\u043D\u044B\u0435 \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B"
  titleLatin: Medulla renalis
  systemType: 5
  description: "\u041C\u043E\u0437\u0433\u043E\u0432\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E
    \u0432 \u0432\u0438\u0434\u0435 8-18 \u043A\u043E\u043D\u0443\u0441\u043E\u0432\u0438\u0434\u043D\u044B\u0445
    \u043F\u0438\u0440\u0430\u043C\u0438\u0434, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0445
    \u043F\u0435\u0442\u043B\u0438 \u0413\u0435\u043D\u043B\u0435 \u0438 \u043F\u0440\u044F\u043C\u044B\u0435
    \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0442\u0440\u0443\u0431\u043A\u0438."
  clinicalFact: "\u0412 \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u0430\u0445 \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u0430\u044F \u043C\u043E\u0447\u0430
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E
    \u043E\u0441\u043C\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0433\u0440\u0430\u0434\u0438\u0435\u043D\u0442\u0430 \u0438\u043D\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u044F."
