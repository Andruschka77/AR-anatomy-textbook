  partId: part_spleen
  titleRu: "\u0421\u0435\u043B\u0435\u0437\u0435\u043D\u043A\u0430"
  titleLatin: Lien
  systemType: 2
  description: "\u041A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0439 \u043E\u0440\u0433\u0430\u043D
    \u043B\u0438\u043C\u0444\u043E\u0438\u0434\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B,
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432 \u043B\u0435\u0432\u043E\u043C \u043F\u043E\u0434\u0440\u0435\u0431\u0435\u0440\u044C\u0435.
    \u0421\u043B\u0443\u0436\u0438\u0442 \u0444\u0438\u043B\u044C\u0442\u0440\u043E\u043C
    \u043A\u0440\u043E\u0432\u0438, \u0434\u0435\u043F\u043E \u0442\u0440\u043E\u043C\u0431\u043E\u0446\u0438\u0442\u043E\u0432
    \u0438 \u0444\u0430\u0431\u0440\u0438\u043A\u043E\u0439 \u0430\u043D\u0442\u0438\u0442\u0435\u043B."
  clinicalFact: "\u0421\u0435\u043B\u0435\u0437\u0435\u043D\u043A\u0443 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442
    \xAB\u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435\u043C \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432\xBB:
    \u043C\u0430\u043A\u0440\u043E\u0444\u0430\u0433\u0438 \u043E\u0440\u0433\u0430\u043D\u0430
    \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E \u0443\u0442\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442
    \u0441\u0432\u044B\u0448\u0435 200 \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u043E\u0432
    \u0441\u043E\u0441\u0442\u0430\u0440\u0438\u0432\u0448\u0438\u0445\u0441\u044F
    \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432."
  voiceoverClip: {fileID: 0}
