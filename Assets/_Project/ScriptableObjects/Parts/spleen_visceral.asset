  partId: spleen_visceral
  titleRu: "\u0412\u0438\u0441\u0446\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C"
  titleLatin: Facies visceralis
  systemType: 2
  description: "\u041C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0441 \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0432\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u043E\u0442
    \u0436\u0435\u043B\u0443\u0434\u043A\u0430, \u043B\u0435\u0432\u043E\u0439 \u043F\u043E\u0447\u043A\u0438
    \u0438 \u043E\u0431\u043E\u0434\u043E\u0447\u043D\u043E\u0439 \u043A\u0438\u0448\u043A\u0438."
  clinicalFact: "\u0411\u0435\u043B\u0430\u044F \u043F\u0443\u043B\u044C\u043F\u0430
    \u0432\u0438\u0441\u0446\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u043E\u043D\u044B
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u043B\u0438\u043C\u0444\u043E\u0438\u0434\u043D\u044B\u0445
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u043E\u0432, \u0441\u0438\u043D\u0442\u0435\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0445
    \u0438\u043C\u043C\u0443\u043D\u043E\u0433\u043B\u043E\u0431\u0443\u043B\u0438\u043D\u044B."
