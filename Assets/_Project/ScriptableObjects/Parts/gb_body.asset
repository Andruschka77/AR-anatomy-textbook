  titleRu: "\u0422\u0435\u043B\u043E \u0436\u0435\u043B\u0447\u043D\u043E\u0433\u043E
    \u043F\u0443\u0437\u044B\u0440\u044F"
  titleLatin: Corpus vesicae biliaris
  systemType: 5
  description: "\u0426\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0430\u0440 \u0432 \u044F\u043C\u043A\u0435
    \u0432\u0438\u0441\u0446\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043F\u0435\u0447\u0435\u043D\u0438, \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u0443\u044E\u0449\u0438\u0439
    \u043F\u0435\u0447\u0435\u043D\u043E\u0447\u043D\u0443\u044E \u0436\u0435\u043B\u0447\u044C."
  clinicalFact: "\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F \u043F\u0443\u0437\u044B\u0440\u044F
    \u0440\u0435\u0430\u0431\u0441\u043E\u0440\u0431\u0438\u0440\u0443\u0435\u0442
    \u0434\u043E 90% \u0432\u043E\u0434\u044B, \u0434\u0435\u043B\u0430\u044F \u043F\u0443\u0437\u044B\u0440\u043D\u0443\u044E
    \u0436\u0435\u043B\u0447\u044C \u0432 10 \u0440\u0430\u0437 \u0431\u043E\u043B\u0435\u0435
    \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439."
