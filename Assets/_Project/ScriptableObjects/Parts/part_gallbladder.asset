  titleRu: "\u0416\u0435\u043B\u0447\u043D\u044B\u0439 \u043F\u0443\u0437\u044B\u0440\u044C"
  titleLatin: Vesica biliaris
  systemType: 5
  description: "\u0420\u0435\u0437\u0435\u0440\u0432\u0443\u0430\u0440 \u0435\u043C\u043A\u043E\u0441\u0442\u044C\u044E
    40-70 \u043C\u043B \u043D\u0430 \u043D\u0438\u0436\u043D\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043F\u0435\u0447\u0435\u043D\u0438, \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u0438 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u0443\u044E\u0449\u0438\u0439
    \u0436\u0435\u043B\u0447\u044C \u0434\u043B\u044F \u044D\u043C\u0443\u043B\u044C\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u043F\u0438\u0449\u0435\u0432\u044B\u0445 \u0436\u0438\u0440\u043E\u0432."
  clinicalFact: "\u0416\u0435\u043B\u0447\u044C \u0432 \u043F\u0443\u0437\u044B\u0440\u0435
    \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0432 5-10 \u0440\u0430\u0437 \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u0447\u0435\u043C
    \u0432 \u043F\u0435\u0447\u0435\u043D\u0438, \u0437\u0430 \u0441\u0447\u0435\u0442
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0433\u043E
    \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044F \u0432\u043E\u0434\u044B
    \u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043B\u0438\u0442\u043E\u0432."
