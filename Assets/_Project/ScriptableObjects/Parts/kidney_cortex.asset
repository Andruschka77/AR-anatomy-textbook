  partId: kidney_cortex
  titleRu: "\u041A\u043E\u0440\u043A\u043E\u0432\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E
    \u043F\u043E\u0447\u043A\u0438"
  titleLatin: Cortex renalis
  systemType: 5
  description: "\u041D\u0430\u0440\u0443\u0436\u043D\u044B\u0439 \u0441\u043B\u043E\u0439
    \u043F\u043E\u0447\u043A\u0438 \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439
    4-5 \u043C\u043C, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439
    \u043F\u043E\u0447\u0435\u0447\u043D\u044B\u0435 \u043A\u043B\u0443\u0431\u043E\u0447\u043A\u0438
    (\u0442\u0435\u043B\u044C\u0446\u0430 \u041C\u0430\u043B\u044C\u043F\u0438\u0433\u0438)
    \u0438 \u0438\u0437\u0432\u0438\u0442\u044B\u0435 \u043A\u0430\u043D\u0430\u043B\u044C\u0446\u044B
    \u043D\u0435\u0444\u0440\u043E\u043D\u043E\u0432."
  clinicalFact: "\u0412 \u043A\u043E\u0440\u043A\u043E\u0432\u043E\u043C \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435
    \u043E\u0431\u0435\u0438\u0445 \u043F\u043E\u0447\u0435\u043A \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
    \u043E\u043A\u043E\u043B\u043E 2 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
    \u043D\u0435\u0444\u0440\u043E\u043D\u043E\u0432, \u0444\u0438\u043B\u044C\u0442\u0440\u0443\u044E\u0449\u0438\u0445
    \u043F\u043B\u0430\u0437\u043C\u0443 \u043A\u0440\u043E\u0432\u0438."
  voiceoverClip: {fileID: 0}
