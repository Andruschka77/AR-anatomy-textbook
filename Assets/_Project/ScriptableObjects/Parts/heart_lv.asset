  partId: heart_lv
  titleRu: "\u041B\u0435\u0432\u044B\u0439 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u0435\u043A"
  titleLatin: Ventriculus sinister
  systemType: 2
  description: "\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u043D\u0430\u0441\u043E\u0441\u043D\u0430\u044F
    \u043A\u0430\u043C\u0435\u0440\u0430 \u0441\u0435\u0440\u0434\u0446\u0430 \u0441
    \u043C\u043E\u0449\u043D\u043E\u0439 \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0439
    \u0441\u0442\u0435\u043D\u043A\u043E\u0439 (\u043C\u0438\u043E\u043A\u0430\u0440\u0434\u043E\u043C)
    \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439 \u0434\u043E 12-15 \u043C\u043C.
    \u041D\u0430\u0433\u043D\u0435\u0442\u0430\u0435\u0442 \u043E\u043A\u0441\u0438\u0433\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E
    \u043A\u0440\u043E\u0432\u044C \u0432 \u0430\u043E\u0440\u0442\u0443 \u043F\u043E\u0434
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043E\u043A\u043E\u043B\u043E
    120 \u043C\u043C \u0440\u0442. \u0441\u0442."
  clinicalFact: "\u041F\u0440\u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0433\u0438\u043F\u0435\u0440\u0442\u043E\u043D\u0438\u0438 \u0441\u0442\u0435\u043D\u043A\u0430
    \u043B\u0435\u0432\u043E\u0433\u043E \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0430
    \u0433\u0438\u043F\u0435\u0440\u0442\u0440\u043E\u0444\u0438\u0440\u0443\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0441\u0442\u0438
    \u043A \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0439 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438."
  voiceoverClip: {fileID: 0}
