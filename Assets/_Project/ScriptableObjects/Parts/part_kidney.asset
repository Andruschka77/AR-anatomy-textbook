  titleRu: "\u041F\u043E\u0447\u043A\u0438"
  titleLatin: Ren
  systemType: 5
  description: "\u041F\u0430\u0440\u043D\u044B\u0439 \u043E\u0440\u0433\u0430\u043D
    \u0437\u0430\u0431\u0440\u044E\u0448\u0438\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430,
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u0432\u043E\u0434\u043D\u043E-\u0441\u043E\u043B\u0435\u0432\u043E\u0439
    \u0433\u043E\u043C\u0435\u043E\u0441\u0442\u0430\u0437, \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0442\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
    \u043D\u0435\u0444\u0440\u043E\u043D\u044B."
  clinicalFact: "\u041F\u043E\u0447\u043A\u0438 \u0444\u0438\u043B\u044C\u0442\u0440\u0443\u044E\u0442
    \u043E\u043A\u043E\u043B\u043E 1700 \u043B\u0438\u0442\u0440\u043E\u0432 \u043A\u0440\u043E\u0432\u0438
    \u0432 \u0441\u0443\u0442\u043A\u0438, \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044F
    150-180 \u043B\u0438\u0442\u0440\u043E\u0432 \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u043E\u0439
    \u043C\u043E\u0447\u0438, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0440\u0435\u0430\u0431\u0441\u043E\u0440\u0431\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    99% \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438."
