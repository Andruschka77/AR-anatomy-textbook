  titleRu: "\u041B\u0435\u0432\u043E\u0435 \u043B\u0435\u0433\u043A\u043E\u0435 (2
    \u0434\u043E\u043B\u0438)"
  titleLatin: Pulmo sinister
  systemType: 4
  description: "\u0420\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u043E \u043A\u043E\u0441\u043E\u0439
    \u0449\u0435\u043B\u044C\u044E \u043D\u0430 2 \u0434\u043E\u043B\u0438 (\u0432\u0435\u0440\u0445\u043D\u044E\u044E
    \u0438 \u043D\u0438\u0436\u043D\u044E\u044E) \u0438 \u0438\u043C\u0435\u0435\u0442
    \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0443\u044E
    \u0432\u044B\u0440\u0435\u0437\u043A\u0443 (incisura cardiaca)."
  clinicalFact: "\u041E\u0431\u0449\u0430\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u044C
    \u0430\u043B\u044C\u0432\u0435\u043E\u043B\u044F\u0440\u043D\u043E\u0439 \u0434\u044B\u0445\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043E\u0431\u043E\u0438\u0445
    \u043B\u0435\u0433\u043A\u0438\u0445 \u043D\u0430 \u0432\u0434\u043E\u0445\u0435
    \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 100-120 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0445
    \u043C\u0435\u0442\u0440\u043E\u0432."
