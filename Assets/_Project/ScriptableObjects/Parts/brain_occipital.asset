  partId: brain_occipital
  titleRu: "\u0417\u0430\u0442\u044B\u043B\u043E\u0447\u043D\u0430\u044F \u0434\u043E\u043B\u044F"
  titleLatin: Lobus occipitalis
  systemType: 3
  description: "\u041F\u0435\u0440\u0432\u0438\u0447\u043D\u0430\u044F \u0438 \u0430\u0441\u0441\u043E\u0446\u0438\u0430\u0442\u0438\u0432\u043D\u0430\u044F
    \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u0440\u0430.
    \u041E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0441\u0442\u0438\u043C\u0443\u043B\u044B, \u0446\u0432\u0435\u0442\u0430, \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0444\u043E\u0440\u043C\u044B \u0438 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432."
  clinicalFact: "\u0414\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0435
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0448\u043F\u043E\u0440\u043D\u043E\u0439
    \u0431\u043E\u0440\u043E\u0437\u0434\u044B \u0432\u0435\u0434\u0435\u0442 \u043A
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0440\u043A\u043E\u0432\u043E\u0439
    \u0441\u043B\u0435\u043F\u043E\u0442\u0435 \u043F\u0440\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438
    \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u0437\u0440\u0430\u0447\u043A\u043E\u0432
    \u043D\u0430 \u0441\u0432\u0435\u0442."
  voiceoverClip: {fileID: 0}
