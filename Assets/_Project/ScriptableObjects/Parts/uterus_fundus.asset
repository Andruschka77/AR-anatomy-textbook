  systemType: 5
  description: "\u0412\u0435\u0440\u0445\u043D\u044F\u044F \u043A\u0443\u043F\u043E\u043B\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u043C\u0430\u0442\u043A\u0438, \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u044E\u0449\u0430\u044F\u0441\u044F
    \u043D\u0430\u0434 \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u044C\u044E
    \u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F \u043C\u0430\u0442\u043E\u0447\u043D\u044B\u0445
    \u0442\u0440\u0443\u0431."
  clinicalFact: "\u0412\u044B\u0441\u043E\u0442\u0430 \u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0434\u043D\u0430 \u043C\u0430\u0442\u043A\u0438 \u043D\u0430\u0434 \u043B\u043E\u043D\u043D\u044B\u043C
    \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u0435\u043C \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043C\u0430\u0440\u043A\u0435\u0440\u043E\u043C \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430."
