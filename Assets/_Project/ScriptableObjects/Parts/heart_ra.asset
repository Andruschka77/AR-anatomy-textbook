  titleRu: "\u041F\u0440\u0430\u0432\u043E\u0435 \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u0435"
  titleLatin: Atrium dextrum
  systemType: 2
  description: "\u041F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0441\u044E
    \u0432\u0435\u043D\u043E\u0437\u043D\u0443\u044E \u043A\u0440\u043E\u0432\u044C
    \u0438\u0437 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0438 \u043D\u0438\u0436\u043D\u0435\u0439
    \u043F\u043E\u043B\u044B\u0445 \u0432\u0435\u043D \u0438 \u0432\u0435\u043D\u043E\u0437\u043D\u043E\u0433\u043E
    \u0441\u0438\u043D\u0443\u0441\u0430 \u0441\u0435\u0440\u0434\u0446\u0430."
  clinicalFact: "\u0412 \u0441\u0442\u0435\u043D\u043A\u0435 \u043F\u0440\u0430\u0432\u043E\u0433\u043E
    \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u044F \u0437\u0430\u043B\u0435\u0433\u0430\u0435\u0442
    \u0441\u0438\u043D\u0443\u0441\u043D\u043E-\u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u043D\u044B\u0439
    \u0443\u0437\u0435\u043B \u041A\u0438\u0441\u0430-\u0424\u043B\u0430\u043A\u0430
    \u2014 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043F\u0435\u0439\u0441\u043C\u0435\u0439\u043A\u0435\u0440
    \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0449\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0441\u0435\u0440\u0434\u0446\u0430."
