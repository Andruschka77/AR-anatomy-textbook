  partId: heart_aorta
  titleRu: "\u0414\u0443\u0433\u0430 \u0430\u043E\u0440\u0442\u044B"
  titleLatin: Arcus aortae
  systemType: 2
  description: "\u041A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u043E\u0441\u0443\u0434 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430,
    \u043E\u0442\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u043E\u0442 \u043B\u0435\u0432\u043E\u0433\u043E
    \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0430. \u041E\u0442 \u0434\u0443\u0433\u0438
    \u043E\u0442\u0445\u043E\u0434\u044F\u0442 \u0431\u0440\u0430\u0445\u0438\u043E\u0446\u0435\u0444\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u0442\u0432\u043E\u043B, \u043B\u0435\u0432\u0430\u044F \u043E\u0431\u0449\u0430\u044F
    \u0441\u043E\u043D\u043D\u0430\u044F \u0438 \u043B\u0435\u0432\u0430\u044F \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0447\u043D\u0430\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u0438, \u043A\u0440\u043E\u0432\u043E\u0441\u043D\u0430\u0431\u0436\u0430\u044E\u0449\u0438\u0435
    \u043C\u043E\u0437\u0433 \u0438 \u0432\u0435\u0440\u0445\u043D\u0438\u0435 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438."
  clinicalFact: "\u0410\u043D\u0435\u0432\u0440\u0438\u0437\u043C\u0430 \u0434\u0443\u0433\u0438
    \u0430\u043E\u0440\u0442\u044B \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0445
    \u0441\u043E\u0441\u0443\u0434\u0438\u0441\u0442\u044B\u0445 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439
    \u0441 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u043A\u0440\u043E\u0432\u043E\u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C."
  voiceoverClip: {fileID: 0}
