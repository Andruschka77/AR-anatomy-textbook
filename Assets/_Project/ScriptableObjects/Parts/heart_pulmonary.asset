  partId: heart_pulmonary
  titleRu: "\u041B\u0435\u0433\u043E\u0447\u043D\u044B\u0439 \u0441\u0442\u0432\u043E\u043B"
  titleLatin: Truncus pulmonalis
  systemType: 2
  description: "\u0428\u0438\u0440\u043E\u043A\u0438\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u0442\u0432\u043E\u043B \u043C\u0430\u043B\u043E\u0433\u043E \u043A\u0440\u0443\u0433\u0430,
    \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u043E\u0442
    \u043F\u0440\u0430\u0432\u043E\u0433\u043E \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0430
    \u0438 \u0434\u0435\u043B\u044F\u0449\u0438\u0439\u0441\u044F \u043D\u0430 \u043F\u0440\u0430\u0432\u0443\u044E
    \u0438 \u043B\u0435\u0432\u0443\u044E \u043B\u0435\u0433\u043E\u0447\u043D\u044B\u0435
    \u0430\u0440\u0442\u0435\u0440\u0438\u0438."
  clinicalFact: "\u0412 \u043B\u0435\u0433\u043E\u0447\u043D\u043E\u043C \u0441\u0442\u0432\u043E\u043B\u0435
    \u0442\u0435\u0447\u0435\u0442 \u0432\u0435\u043D\u043E\u0437\u043D\u0430\u044F
    \u043A\u0440\u043E\u0432\u044C, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0442\u0438\u043F \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F \u0442\u0440\u0435\u0445\u0441\u043B\u043E\u0439\u043D\u043E\u0439
    \u0441\u043E\u0441\u0443\u0434\u0438\u0441\u0442\u043E\u0439 \u0441\u0442\u0435\u043D\u043A\u0438."
