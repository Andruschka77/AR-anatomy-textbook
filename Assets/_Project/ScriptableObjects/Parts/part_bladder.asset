  partId: part_bladder
  titleRu: "\u041C\u043E\u0447\u0435\u0432\u043E\u0439 \u043F\u0443\u0437\u044B\u0440\u044C"
  titleLatin: Vesica urinaria
  systemType: 5
  description: "\u041C\u044B\u0448\u0435\u0447\u043D\u044B\u0439 \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0430\u0440
    \u0435\u043C\u043A\u043E\u0441\u0442\u044C\u044E 300-700 \u043C\u043B \u0434\u043B\u044F
    \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F \u0438 \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0438 \u043C\u043E\u0447\u0438
    \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u0432\u0435\u0433\u0435\u0442\u0430\u0442\u0438\u0432\u043D\u043E\u0439
    \u043D\u0435\u0440\u0432\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
  clinicalFact: "\u0421\u0442\u0435\u043D\u043A\u0430 \u043F\u0443\u0437\u044B\u0440\u044F
    \u0432\u044B\u0441\u0442\u043B\u0430\u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043D\u044B\u043C
    \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C (\u0443\u0440\u043E\u0442\u0435\u043B\u0438\u0435\u043C),
    \u043A\u043B\u0435\u0442\u043A\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442 \u0434\u0440\u0443\u0433 \u043F\u043E
    \u0434\u0440\u0443\u0433\u0443 \u043F\u0440\u0438 \u0440\u0430\u0441\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    \u043E\u0440\u0433\u0430\u043D\u0430."
