  partId: part_pancreas
  titleRu: "\u041F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u0430\u044F
    \u0436\u0435\u043B\u0435\u0437\u0430"
  titleLatin: Pancreas
  systemType: 5
  description: "\u041E\u0440\u0433\u0430\u043D \u0441\u043C\u0435\u0448\u0430\u043D\u043D\u043E\u0439
    \u0441\u0435\u043A\u0440\u0435\u0446\u0438\u0438. \u041F\u0440\u043E\u0434\u0443\u0446\u0438\u0440\u0443\u0435\u0442
    \u043F\u0430\u043D\u043A\u0440\u0435\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0441\u043E\u043A \u0434\u043B\u044F \u0440\u0430\u0441\u0449\u0435\u043F\u043B\u0435\u043D\u0438\u044F
    \u0431\u0435\u043B\u043A\u043E\u0432, \u0436\u0438\u0440\u043E\u0432 \u0438 \u0443\u0433\u043B\u0435\u0432\u043E\u0434\u043E\u0432,
    \u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u043A\u0438 \u041B\u0430\u043D\u0433\u0435\u0440\u0433\u0430\u043D\u0441\u0430
    \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442 \u0438\u043D\u0441\u0443\u043B\u0438\u043D
    \u0438 \u0433\u043B\u044E\u043A\u0430\u0433\u043E\u043D."
  clinicalFact: "\u0418\u043D\u0441\u0443\u043B\u0438\u043D \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u043A\u0430\u043D\u0430\u043B\u044B
    GLUT-4, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u0433\u043B\u044E\u043A\u043E\u0437\u0435
    \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C \u0432\u043D\u0443\u0442\u0440\u044C
    \u043A\u043B\u0435\u0442\u043E\u043A \u0434\u043B\u044F \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0410\u0422\u0424."
  voiceoverClip: {fileID: 0}
