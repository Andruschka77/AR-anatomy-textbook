  partId: spleen_hilum
  titleRu: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0441\u0435\u043B\u0435\u0437\u0435\u043D\u043A\u0438
    \u0438 \u0441\u043E\u0441\u0443\u0434\u044B"
  titleLatin: Hilum splenicum
  systemType: 2
  description: "\u041F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u0430\u044F \u0449\u0435\u043B\u044C,
    \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
    \u0438\u0437\u0432\u0438\u0442\u0430\u044F \u0441\u0435\u043B\u0435\u0437\u0435\u043D\u043E\u0447\u043D\u0430\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u044F, \u0432\u0435\u043D\u0430 \u0438 \u043D\u0435\u0440\u0432\u043D\u044B\u0435
    \u0441\u0442\u0432\u043E\u043B\u044B."
  clinicalFact: "\u0421\u0435\u043B\u0435\u0437\u0435\u043D\u043A\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0444\u0438\u043B\u044C\u0442\u0440\u043E\u043C
    \u043A\u0440\u043E\u0432\u0438, \u0443\u0442\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u043C
    \u0441\u043E\u0442\u043D\u0438 \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u043E\u0432
    \u0441\u043E\u0441\u0442\u0430\u0440\u0438\u0432\u0448\u0438\u0445\u0441\u044F
    \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432 \u0432 \u0441\u0443\u0442\u043A\u0438."
  voiceoverClip: {fileID: 0}
