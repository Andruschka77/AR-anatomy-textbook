  titleRu: "\u0422\u0435\u043B\u043E \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B"
  titleLatin: Corpus pancreatis
  systemType: 5
  description: "\u0422\u0440\u0435\u0445\u0433\u0440\u0430\u043D\u043D\u0430\u044F
    \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u044C \u043E\u0440\u0433\u0430\u043D\u0430,
    \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u044E\u0449\u0430\u044F \u0430\u043E\u0440\u0442\u0443
    \u0438 \u043D\u0438\u0436\u043D\u044E\u044E \u043F\u043E\u043B\u0443\u044E \u0432\u0435\u043D\u0443.
    \u0421\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F
    \u043E\u0441\u0442\u0440\u043E\u0432\u043A\u043E\u0432 \u041B\u0430\u043D\u0433\u0435\u0440\u0433\u0430\u043D\u0441\u0430."
  clinicalFact: "\u0411\u0435\u0442\u0430-\u043A\u043B\u0435\u0442\u043A\u0438 \u043E\u0441\u0442\u0440\u043E\u0432\u043A\u043E\u0432
    \u041B\u0430\u043D\u0433\u0435\u0440\u0433\u0430\u043D\u0441\u0430 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E
    \u0441\u0435\u043A\u0440\u0435\u0442\u0438\u0440\u0443\u044E\u0442 \u0433\u043E\u0440\u043C\u043E\u043D
    \u0438\u043D\u0441\u0443\u043B\u0438\u043D \u0432 \u043A\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u043D\u043E\u0435
    \u0440\u0443\u0441\u043B\u043E."
