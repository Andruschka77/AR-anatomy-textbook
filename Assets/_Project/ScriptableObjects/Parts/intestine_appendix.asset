  titleLatin: Appendix vermiformis
  systemType: 5
  description: "\u0423\u0437\u043A\u0438\u0439 \u0442\u0440\u0443\u0431\u0447\u0430\u0442\u044B\u0439
    \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A \u0441\u043B\u0435\u043F\u043E\u0439
    \u043A\u0438\u0448\u043A\u0438, \u0431\u043E\u0433\u0430\u0442\u044B\u0439 \u043B\u0438\u043C\u0444\u043E\u0438\u0434\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u044C\u044E."
  clinicalFact: "\u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0444\u0443\u043D\u043A\u0446\u0438\u044E
