  titleRu: "\u0425\u0432\u043E\u0441\u0442 \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B"
  titleLatin: Cauda pancreatis
  systemType: 5
  description: "\u0421\u0443\u0436\u0435\u043D\u043D\u044B\u0439 \u043B\u0435\u0432\u044B\u0439
    \u043A\u043E\u043D\u0435\u0446 \u043E\u0440\u0433\u0430\u043D\u0430, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u043A\u043E\u0441\u043E \u0432\u0432\u0435\u0440\u0445 \u043A \u0432\u0438\u0441\u0446\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0432\u043E\u0440\u043E\u0442
    \u0441\u0435\u043B\u0435\u0437\u0435\u043D\u043A\u0438."
  clinicalFact: "\u041F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u044D\u043D\u0434\u043E\u043A\u0440\u0438\u043D\u043D\u044B\u0445
    \u043E\u0441\u0442\u0440\u043E\u0432\u043A\u043E\u0432 \u0432 \u0445\u0432\u043E\u0441\u0442\u0435
    \u0436\u0435\u043B\u0435\u0437\u044B \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u044B\u0448\u0435, \u0447\u0435\u043C \u0432 \u0435\u0435 \u0433\u043E\u043B\u043E\u0432\u043A\u0435."
