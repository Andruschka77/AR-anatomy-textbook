  partId: liver_left_lobe
  titleRu: "\u041B\u0435\u0432\u0430\u044F \u0434\u043E\u043B\u044F \u043F\u0435\u0447\u0435\u043D\u0438"
  titleLatin: Lobus sinister hepatis
  systemType: 5
  description: "\u041C\u0435\u043D\u044C\u0448\u0430\u044F \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0434\u043E\u043B\u044F \u043F\u0435\u0447\u0435\u043D\u0438, \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u043D\u0430\u044F
    \u0441\u0435\u0440\u043F\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u043A\u043E\u0439.
    \u0412\u043A\u043B\u044E\u0447\u0430\u0435\u0442 II \u0438 III \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u044B
    \u043F\u043E \u041A\u0443\u0438\u043D\u043E."
  clinicalFact: "\u041A\u043B\u0435\u0442\u043A\u0438 \u043B\u0435\u0432\u043E\u0439
    \u0434\u043E\u043B\u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E \u043A
    \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u0433\u0438\u043F\u0435\u0440\u0442\u0440\u043E\u0444\u0438\u0438."
