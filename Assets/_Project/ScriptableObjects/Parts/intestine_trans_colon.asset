  titleRu: "\u041F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u0430\u044F \u043E\u0431\u043E\u0434\u043E\u0447\u043D\u0430\u044F
    \u043A\u0438\u0448\u043A\u0430"
  titleLatin: Colon transversum
  systemType: 5
  description: "\u0421\u0430\u043C\u044B\u0439 \u0434\u043B\u0438\u043D\u043D\u044B\u0439
    \u0438 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0439 \u0441\u0435\u0433\u043C\u0435\u043D\u0442
    \u043E\u0431\u043E\u0434\u043E\u0447\u043D\u043E\u0439 \u043A\u0438\u0448\u043A\u0438,
    \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u044E\u0449\u0438\u0439 \u0431\u0440\u044E\u0448\u043D\u0443\u044E
    \u043F\u043E\u043B\u043E\u0441\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0430
    \u043D\u0430\u043B\u0435\u0432\u043E."
  clinicalFact: "\u041F\u043E\u0434\u0432\u0435\u0448\u0435\u043D\u0430 \u043D\u0430
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0431\u0440\u044B\u0436\u0435\u0439\u043A\u0435
    \u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0445\u0430\u0443\u0441\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0438\u0432\u0430\u044E\u0449\u0438\u0435
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
