  titleRu: "\u0422\u0435\u043B\u043E \u0436\u0435\u043B\u0443\u0434\u043A\u0430"
  titleLatin: Corpus gastris
  systemType: 5
  description: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u0416\u041A\u0422, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0430\u044F
    \u0436\u0435\u043B\u0435\u0437\u044B \u0441 \u043F\u0430\u0440\u0438\u0435\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043A\u043B\u0435\u0442\u043A\u0430\u043C\u0438, \u0441\u0435\u043A\u0440\u0435\u0442\u0438\u0440\u0443\u044E\u0449\u0438\u043C\u0438
    HCl \u0438 \u0444\u0430\u043A\u0442\u043E\u0440 \u041A\u0430\u0441\u043B\u0430."
  clinicalFact: "\u0424\u0430\u043A\u0442\u043E\u0440 \u041A\u0430\u0441\u043B\u0430
    \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u0438\u0442\u0430\u043C\u0438\u043D
    B12, \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0430\u044F
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0442\u044F\u0436\u0435\u043B\u043E\u0439
    \u043F\u0435\u0440\u043D\u0438\u0446\u0438\u043E\u0437\u043D\u043E\u0439 \u0430\u043D\u0435\u043C\u0438\u0438."
