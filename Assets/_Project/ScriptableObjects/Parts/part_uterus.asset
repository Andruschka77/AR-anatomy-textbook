  partId: part_uterus
  titleRu: "\u041C\u0430\u0442\u043A\u0430"
  titleLatin: Uterus
  systemType: 5
  description: "\u0413\u043B\u0430\u0434\u043A\u043E\u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0439
    \u043F\u043E\u043B\u044B\u0439 \u043E\u0440\u0433\u0430\u043D \u0436\u0435\u043D\u0441\u043A\u043E\u0439
    \u0440\u0435\u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u0438\u043C\u043F\u043B\u0430\u043D\u0442\u0430\u0446\u0438\u044E \u044D\u043C\u0431\u0440\u0438\u043E\u043D\u0430
    \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043F\u043B\u043E\u0434\u0430
    \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u0438."
  clinicalFact: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u043E\u0431\u044A\u0435\u043C \u043F\u043E\u043B\u043E\u0441\u0442\u0438 \u043C\u0430\u0442\u043A\u0438
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 500 \u0440\u0430\u0437, \u0430 \u043C\u0430\u0441\u0441\u0430 \u043C\u0438\u043E\u043C\u0435\u0442\u0440\u0438\u044F
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0441 50 \u0434\u043E
    1200 \u0433\u0440\u0430\u043C\u043C\u043E\u0432."
