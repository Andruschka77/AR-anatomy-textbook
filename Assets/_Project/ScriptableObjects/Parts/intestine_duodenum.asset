  titleRu: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0430\u044F
    \u043A\u0438\u0448\u043A\u0430"
  titleLatin: Duodenum
  systemType: 5
  description: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B
    \u0442\u043E\u043D\u043A\u043E\u0439 \u043A\u0438\u0448\u043A\u0438 \u0434\u043B\u0438\u043D\u043E\u0439
    25-30 \u0441\u043C, \u043A\u0443\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0436\u0435\u043B\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u043E\u043A
    \u0438 \u043F\u0440\u043E\u0442\u043E\u043A \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B."
  clinicalFact: "\u0417\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
    \u043A\u0438\u0441\u043B\u043E\u0433\u043E \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0433\u043E
    \u0441\u043E\u043A\u0430 \u0449\u0435\u043B\u043E\u0447\u043D\u044B\u043C\u0438
    \u043F\u0430\u043D\u043A\u0440\u0435\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0444\u0435\u0440\u043C\u0435\u043D\u0442\u0430\u043C\u0438."
