  partId: lung_trachea
  titleRu: "\u0422\u0440\u0430\u0445\u0435\u044F \u0438 \u0433\u043B\u0430\u0432\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438"
  titleLatin: Trachea et bronchi
  systemType: 4
  description: "\u0414\u044B\u0445\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0442\u0440\u0443\u0431\u043A\u0430 \u0434\u043B\u0438\u043D\u043E\u0439 10-12
    \u0441\u043C \u0438\u0437 16-20 \u0433\u0438\u0430\u043B\u0438\u043D\u043E\u0432\u044B\u0445
    \u0445\u0440\u044F\u0449\u0435\u0432\u044B\u0445 \u043F\u043E\u043B\u0443\u043A\u043E\u043B\u0435\u0446,
    \u0434\u0435\u043B\u044F\u0449\u0430\u044F\u0441\u044F \u043D\u0430 \u043F\u0440\u0430\u0432\u044B\u0439
    \u0438 \u043B\u0435\u0432\u044B\u0439 \u0433\u043B\u0430\u0432\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438."
  clinicalFact: "\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430
    \u043F\u043E\u043A\u0440\u044B\u0442\u0430 \u043C\u0435\u0440\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C, \u0440\u0435\u0441\u043D\u0438\u0447\u043A\u0438
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E
    \u044D\u0432\u0430\u043A\u0443\u0438\u0440\u0443\u044E\u0442 \u043F\u044B\u043B\u0435\u0432\u044B\u0435
    \u0447\u0430\u0441\u0442\u0438\u0446\u044B \u0432\u0432\u0435\u0440\u0445."
  voiceoverClip: {fileID: 0}
