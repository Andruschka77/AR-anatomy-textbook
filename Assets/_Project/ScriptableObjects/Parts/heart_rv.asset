  partId: heart_rv
  titleRu: "\u041F\u0440\u0430\u0432\u044B\u0439 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u0435\u043A"
  titleLatin: Ventriculus dexter
  systemType: 2
  description: "\u041A\u0430\u043C\u0435\u0440\u0430 \u043C\u0430\u043B\u043E\u0433\u043E
    \u043A\u0440\u0443\u0433\u0430 \u043A\u0440\u043E\u0432\u043E\u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F.
    \u0418\u043C\u0435\u0435\u0442 \u043F\u043E\u043B\u0443\u043B\u0443\u043D\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443 \u0438 \u0441\u0442\u0435\u043D\u043A\u0443 \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439
    3-5 \u043C\u043C. \u0412\u044B\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0435\u0442
    \u0432\u0435\u043D\u043E\u0437\u043D\u0443\u044E \u043A\u0440\u043E\u0432\u044C
    \u0432 \u043B\u0435\u0433\u043E\u0447\u043D\u044B\u0439 \u0441\u0442\u0432\u043E\u043B
    \u0434\u043B\u044F \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u0438\u044F \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u043E\u043C
    \u0432 \u043B\u0435\u0433\u043A\u0438\u0445."
  clinicalFact: "\u0422\u0440\u043E\u043C\u0431\u043E\u044D\u043C\u0431\u043E\u043B\u0438\u044F
    \u043B\u0435\u0433\u043E\u0447\u043D\u043E\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0438
    \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0440\u0435\u0437\u043A\u0443\u044E
    \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0443 \u043F\u0440\u0430\u0432\u043E\u0433\u043E
    \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0430 (\u043E\u0441\u0442\u0440\u043E\u0435
    \u043B\u0435\u0433\u043E\u0447\u043D\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435)."
  voiceoverClip: {fileID: 0}
