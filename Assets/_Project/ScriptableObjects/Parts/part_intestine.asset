  titleRu: "\u041A\u0438\u0448\u0435\u0447\u043D\u0438\u043A \u043F\u043E\u043B\u043D\u044B\u0439"
  titleLatin: Intestinum
  systemType: 5
  description: "\u0412\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0442\u043E\u043D\u043A\u0443\u044E
    (5-6 \u043C) \u0438 \u0442\u043E\u043B\u0441\u0442\u0443\u044E (1.5 \u043C) \u043A\u0438\u0448\u043A\u0443.
    \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0433\u0438\u0434\u0440\u043E\u043B\u0438\u0437,
    \u043C\u0438\u043A\u0440\u043E\u0431\u0438\u043E\u043C\u043D\u044B\u0439 \u0441\u0438\u043D\u0442\u0435\u0437
    \u0432\u0438\u0442\u0430\u043C\u0438\u043D\u043E\u0432 \u0438 \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435
    \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432
    \u0432 \u043A\u0440\u043E\u0432\u044C."
  clinicalFact: "\u041F\u043B\u043E\u0449\u0430\u0434\u044C \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u044E\u0449\u0435\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0442\u043E\u043D\u043A\u043E\u0433\u043E
    \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0430 \u0437\u0430 \u0441\u0447\u0435\u0442
    \u043C\u0438\u043A\u0440\u043E\u0432\u043E\u0440\u0441\u0438\u043D\u043E\u043A
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E
    30 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0445 \u043C\u0435\u0442\u0440\u043E\u0432."
