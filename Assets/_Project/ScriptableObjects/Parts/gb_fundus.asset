  partId: gb_fundus
  titleRu: "\u0414\u043D\u043E \u0436\u0435\u043B\u0447\u043D\u043E\u0433\u043E \u043F\u0443\u0437\u044B\u0440\u044F"
  titleLatin: Fundus vesicae biliaris
  systemType: 5
  description: "\u0428\u0438\u0440\u043E\u043A\u0438\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0439
    \u0437\u0430\u043A\u0440\u0443\u0433\u043B\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u043D\u0435\u0446,
    \u0441\u043B\u0435\u0433\u043A\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0438\u0439
    \u0438\u0437-\u043F\u043E\u0434 \u043D\u0438\u0436\u043D\u0435\u0433\u043E \u043A\u0440\u0430\u044F
    \u043F\u0435\u0447\u0435\u043D\u0438."
  clinicalFact: "\u0411\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0438 \u043D\u0430 \u043E\u0431\u043B\u0430\u0441\u0442\u044C
    \u0434\u043D\u0430 \u043D\u0430 \u0432\u0434\u043E\u0445\u0435 (\u0441\u0438\u043C\u043F\u0442\u043E\u043C
    \u041C\u0435\u0440\u0444\u0438) \u2014 \u043F\u0430\u0442\u043E\u0433\u043D\u043E\u043C\u043E\u043D\u0438\u0447\u043D\u044B\u0439
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u0445\u043E\u043B\u0435\u0446\u0438\u0441\u0442\u0438\u0442\u0430."
  voiceoverClip: {fileID: 0}
